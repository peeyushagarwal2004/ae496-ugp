# Large regenerated datasets — never tracked (400+ MB; rebuilt in ~5 min on GPU)
data/
*.npz
*.pkl
*.tar.gz

# ...but the metadata beside them IS tracked. report/numbers.json sources
# twenty of the report's numbers from these files (Cd, St, Ma, grid, blockage,
# the whole convergence sweep), so leaving them untracked means those numbers
# exist only on one laptop and cannot be re-verified from a fresh clone.
# 14 kB of JSON, against 400 MB of .npz that stays ignored.
!data/
data/*
!data/*_meta.json
!data/convergence.json
!data/base_flow_*.json

# underPINN is cloned separately (see COLAB.md / KAGGLE.md)
upinn/
underPINN/

# Results ARE tracked: runs/*.json and figures/*.png are small and are the
# point of a cloud run. Binary artefacts inside them are still excluded by the
# patterns above.

# logs and scratch
runs_quick/
logs_*.txt
# ...except the base-flow fit, whose printed rel L2 is quoted in the report
# and sourced from this file by report/numbers.json.
!logs_base_flow_v4.txt
run_v3_after_v2.sh
run_v4_chain.sh

__pycache__/
*.py[cod]
.ipynb_checkpoints/

# Personal documents that happen to live in this folder — never publish these
*resume*.pdf
*resume*.tex
*cv*.pdf

# Personal resume drafts — kept locally, not published
RESUME_BULLETS.md

# LaTeX build artefacts (report.pdf IS tracked - it is the deliverable)
report/*.aux
report/*.log
report/*.out
report/*.toc
report/*.fls
report/*.fdb_latexmk
