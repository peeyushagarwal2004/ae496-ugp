  journal = {Journal of Fluid Mechanics},
  volume  = {161},
  pages   = {217--237},
  year    = {1985},
  doi     = {10.1017/S0022112085002890}
}

% VERIFIED title/authors/journal/volume/article number/year/DOI at Cambridge
% Core, plus the following contents from the landing page: establishes
% bidirectional vortex-sound coupling as the lock-in mechanism for a cylinder
% in a flow duct with a transverse standing (beta) mode, and quantifies the
% band -- synchronous region 0.98 <= f_s/f_a <= 1.02, beta-mode dominant
% region 0.93 <= f_s/f_a < 0.98 and 1.02 < f_s/f_a <= 1.14, with the peak
% resonant amplitude at the upper boundary of the synchronous region rather
